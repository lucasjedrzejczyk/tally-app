# Tally — variáveis de ambiente (Next.js)
# Copie para .env.local e preencha. Nenhum segredo aqui.
#
# URL e chave PÚBLICA (anon) do Supabase. A anon key é pública por design —
# toda a segurança está no RLS do banco. NUNCA coloque a service_role key aqui
# nem em qualquer variável com prefixo NEXT_PUBLIC_.
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-anon-key-publica

# Cobrança (spec 20) — SÓ no servidor (Vercel), nunca com NEXT_PUBLIC_.
# ASAAS_ENV=sandbox | production
ASAAS_ENV=sandbox
ASAAS_API_KEY=
# Token que você escolhe ao criar o webhook no Asaas (POST /api/billing/asaas)
ASAAS_WEBHOOK_TOKEN=
# Usada só pelo webhook para gravar o plano
SUPABASE_SERVICE_ROLE_KEY=
